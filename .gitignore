# raw source data -- 20+ GB of Landsat scenes, DEM tiles, WorldClim grids,
# not needed to reproduce the dashboard or any processed CSV
02_Data_Raw/

# large intermediate rasters -- every outcome the dashboard actually reads
# comes from the CSVs derived from these, not the rasters themselves
03_Data_Processed/**/*.tif
03_Data_Processed/**/*.tif.aux.xml
# ...except the small 300 m NDVI/LST rasters the pipeline needs (2-3 MB each)
!03_Data_Processed/Vegetation/ndvi_*_300m*.tif
!03_Data_Processed/Vegetation/ndvi_fixed_300m_June2026.tif
!03_Data_Processed/Climate/lst_fixed_300m_June2026.tif

# large geometry layers not used by the dashboard (Infrastructure was
# dropped from scope -- see 07_Methodology_Data.py)
03_Data_Processed/Infrastructure/
03_Data_Processed/Administrative/vidarbha_village_boundary.gpkg

